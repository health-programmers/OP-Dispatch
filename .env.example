# Application
NODE_ENV=development

# Published ports
API_PORT=3000
WEBSOCKET_PORT=4000
WEB_APP_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL (local development values only)
POSTGRES_DB=op_dispatch
POSTGRES_USER=op_dispatch
POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=postgresql://op_dispatch:local-dev-only@postgres:5432/op_dispatch

# Redis
REDIS_URL=redis://redis:6379

# Replace with a generated secret before any shared or production deployment.
JWT_SECRET=local-development-secret-change-before-deploy

# Browser-facing service URLs
VITE_API_URL=http://localhost:3000
VITE_WEBSOCKET_URL=http://localhost:4000
